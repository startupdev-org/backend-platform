# Copy to secrets.properties (gitignored) and fill in.
#   cp src/main/resources/secrets.properties.example src/main/resources/secrets.properties
# Deployed environments set these same keys as environment variables instead.

# Full Neon JDBC connection string, including the TLS parameters Neon requires.
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require&channelBinding=require
DB_USER=
DB_PASSWORD=

# HS256 signing key. Must be at least 32 characters. No default - the app will
# not start without it.
JWT_SECRET=9f849d949b197aa0a918ad9a1c4a6c87d67c45e66860bdb27d052499fa638e3d

# Token lifetime in milliseconds. Defaults to 86400000 (24h) when unset.
JWT_EXPIRATION=86400000

# Comma-separated list of allowed browser origins for /api/**.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Local HTTP port. Render supplies PORT instead and that takes precedence.
SERVER_PORT=8080

# Object storage (Cloudflare R2, public bucket) for logos and employee photos.
# The bucket needs a CORS rule allowing PUT from ALLOWED_ORIGINS. R2_PUBLIC_URL_BASE
# is the bucket's public base URL - the pub-<hash>.r2.dev subdomain for now, a custom
# domain later. R2_ACCESS_KEY_ID/SECRET come from an API token scoped to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL_BASE=https://pub-<hash>.r2.dev
STORAGE_BUCKET=business-assets
