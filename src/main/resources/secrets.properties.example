# Local development secrets. Copy this file to secrets.properties (gitignored) and
# fill in real values. Deployed environments supply the same keys as Render env vars
# instead - application.yml imports this file as "optional:", so its absence is not
# an error there.
#
# Every key in the first block is required: it has no default in application.yml, so
# a missing value fails startup with an unresolvable-placeholder error. That is why
# this file exists - a fresh clone should be able to follow CLAUDE.md and reach a
# running app.

# -- Required: no default in application.yml ---------------------------------
# Full Neon JDBC string, including sslmode and channelBinding.
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require&channelBinding=require
DB_USER=
DB_PASSWORD=

# HS256 signing key, at least 32 characters. JwtUtils fails startup below that,
# deliberately - a shorter key is cheap to forge.
JWT_SECRET=

# Comma-separated origins allowed by CORS. Must include the local frontend, and must
# match the R2 bucket's own CORS rules or every browser upload fails.
ALLOWED_ORIGINS=http://localhost:5173

# Object-storage bucket name. Required even if you never upload an image locally:
# storage.bucket has no default, so an unset value stops the context from starting.
STORAGE_BUCKET=

# -- Optional: these have defaults in application.yml -------------------------
# Access-token lifetime in ms, default 900000 (15 min). The token cannot be revoked,
# so this value *is* the revocation window - do not raise it casually.
#JWT_EXPIRATION=900000
# Refresh-token lifetime in ms, default 2592000000 (30 days). Revocable, single-use.
#JWT_REFRESH_EXPIRATION=2592000000
# Password-reset link lifetime in ms, default 1800000 (30 min).
#PASSWORD_RESET_EXPIRATION=1800000

# Where the SPA lives, used to build the reset link. Default http://localhost:5173.
#FRONTEND_BASE_URL=http://localhost:5173

# Local port. Render supplies PORT, which wins. Default 8080.
#SERVER_PORT=8080

# Cloudflare R2. These default to empty, so the app starts without them - but every
# presigned upload and every public image URL is broken until they are set.
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_PUBLIC_URL_BASE=https://pub-<hash>.r2.dev

# Active Spring profile. Defaults to dev, so set this only to run prod locally.
#SPRING_PROFILES_ACTIVE=dev
